# Copy to .env and fill in what you want. Everything here is optional — anything left blank
# simply stays off. Run `pnpm checkup` at any point to see where you stand.
#
# .env is gitignored. Never commit it.

# ─── Gather Smart Objects ───────────────────────────────────────────────
# Place objects in Gather: Main Menu → Decorate Desk → Smart Objects.
# Each object has its OWN url and secret, both in its ⋮ menu. A key for one object never
# authenticates another, so copy both from the same object in the same visit.
#
# Paste the secret whole, including the `whsec_` prefix. We deliberately do not pre-fill the
# prefix: pasting on top of an existing one produces a corrupted secret that fails with an
# opaque 404.
#
# One object is enough to be useful. You do not need all three.

GATHER_INBOX_URL=
GATHER_INBOX_SECRET=

GATHER_STATUS_URL=
GATHER_STATUS_SECRET=

GATHER_LIGHTBULB_URL=
GATHER_LIGHTBULB_SECRET=

# Optional — change what an object shows.
# Surfaces: inbox · activity-monitor · availability · prod-health
# GATHER_LIGHTBULB_SURFACE=prod-health

# ─── Azure DevOps ───────────────────────────────────────────────────────
# docs/integrations/azure-devops.md
# One PAT covers all three Azure DevOps integrations. Read-only scopes are enough:
# Code (Read), Build (Read), Work Items (Read).

AZDO_ORG_URL=
AZDO_PAT=

# Your address in the organisation — used to tell your PRs from everyone else's.
AZDO_USER_EMAIL=

# Work item states that count as "on my plate right now". Names vary by process template;
# check Azure Boards for yours. Leave blank to skip work items entirely.
# AZDO_WORK_ITEM_STATES=Doing,Rework,To do

# Optional: scope work items to one team, as "Project/Team". Without it the query runs across
# the whole organisation, which cannot ask about sprints.
# AZDO_WORK_ITEM_TEAM=My Project/My Team

# Optional: show only the sprint in progress. Requires AZDO_WORK_ITEM_TEAM above, because Azure
# DevOps refuses @CurrentIteration outside a team context.
# AZDO_WORK_ITEM_CURRENT_SPRINT=true

# Pipelines to watch, as JSON on one line. "match" is an optional regex on the pipeline name.
# Leave blank to skip pipelines entirely.
# AZDO_BUILD_SCOPE=[{"project":"Web"},{"project":"Platform","match":"^api-"}]

# ─── Google Calendar ────────────────────────────────────────────────────
# docs/integrations/google-calendar.md
# Fill in the first two, then run `pnpm authorize:google` — it prints the third.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Outlook / Microsoft 365 ────────────────────────────────────────────
# docs/integrations/outlook.md
# Fill in the first two, then run `pnpm authorize:outlook` — it prints the third.

MS_TENANT_ID=
MS_CLIENT_ID=
MS_REFRESH_TOKEN=

# ─── Uptime monitor (webhook) ───────────────────────────────────────────
# docs/integrations/uptime.md
# The one integration that listens instead of asking. Your monitor POSTs here when something
# goes down. Generate the token with: openssl rand -hex 32
# It is a password: anyone holding it can light up your office.

UPTIME_WEBHOOK_TOKEN=
# UPTIME_WEBHOOK_PORT=8787
# UPTIME_TTL_HOURS=24
# UPTIME_STATE_FILE=./state/incidents.json

# ─── Runtime ────────────────────────────────────────────────────────────

POLL_INTERVAL_SECONDS=60
STATE_FILE=./state/last-sent.json
